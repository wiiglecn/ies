                    },
                    "major_x": {
                        "type": "number",
                        "description": "Major axis vector X component (length defines the radius)."
                    },
                    "major_y": {
                        "type": "number",
                        "description": "Major axis vector Y component (length defines the radius)."
                    },
                    "ratio": {
                        "type": "number",
