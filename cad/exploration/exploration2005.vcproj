				AdditionalDependencies="rxapi.lib acdb16.lib acge16.lib acgiapi.lib achapi16.lib acISMobj16.lib acad.lib acedapi.lib adui16.lib acui16.lib Oleacc.lib mongoose.lib crypt32.lib shlwapi.lib"
